# Compiled files
**/*.class
**/*.exe
**/*.dll
**/*.obj
**/*.o
**/*.out

# Executables without extension (compiled binaries)
**/Arrays/**/*
**/LinkedList/**/*
**/Strings/**/*
# Except directories
!**/Arrays/**/
!**/LinkedList/**/
!**/Strings/**/

# Allow only source files at any level
!**/Arrays/**/*.cpp
!**/Arrays/**/*.c
!**/Arrays/**/*.h
!**/Arrays/**/*.py
!**/Arrays/**/*.java
!**/Arrays/**/*.js
!**/Arrays/**/*.ts
!**/LinkedList/**/*.cpp
!**/LinkedList/**/*.c
!**/LinkedList/**/*.h
!**/LinkedList/**/*.py
!**/LinkedList/**/*.java
!**/LinkedList/**/*.js
!**/LinkedList/**/*.ts
!**/Strings/**/*.cpp
!**/Strings/**/*.c
!**/Strings/**/*.h
!**/Strings/**/*.py
!**/Strings/**/*.java
!**/Strings/**/*.js
!**/Strings/**/*.ts

# Allow specific Makefile and PDF
!**/LinkedList/C++/SinglyLinkedList/Makefile
!**/LinkedList/Singly_Linked_List_in_JS.pdf

# Dependencies
**/node_modules/
**/vendor/

# Environment files
**/.env
**/.env.local

# IDE files
**/.vscode/
**/.idea/
**/*.swp

# OS generated files
.DS_Store
**/Thumbs.db

# Logs
**/*.log
**/logs/

# Build and documentation files (ignore by default)
**/Makefile
**/*.pdf

# Allow directories at root level
!*/

# Allow .gitignore and README
!.gitignore
!README.md
