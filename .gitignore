# Compiled files
**/*.class
**/*.exe
**/*.dll
**/*.obj
**/*.o
**/*.out

# Dependencies
**/node_modules/
**/vendor/

# Environment files
**/.env
**/.env.local

# IDE files
**/.vscode/
**/.idea/
**/*.swp

# OS generated files
.DS_Store
**/Thumbs.db

# Logs
**/*.log
**/logs/

# Allow specific file extensions for C and C++
!*.cpp
!*.c
!*.h

# Allow directories (so we can traverse into them)
!*/

#Allow .gitignore itself
!.gitignore
